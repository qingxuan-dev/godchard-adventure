config_version=5

[application]

config/name="哥查德的大冒险"
config/version="4.0.0"
config/description="GODCHARD ADVENTURE · 重制版 v4.0 全150关高密度反套路平台解谜冒险（支持双端触控键鼠、三级渐进提示、四级奖章与无障碍视觉音频字幕）"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/handheld/orientation=6
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
